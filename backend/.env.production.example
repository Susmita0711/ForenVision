# ==============================================================================
# ForenVision AI Production Backend Configuration Template
# ==============================================================================
# INSTRUCTIONS:
# 1. Copy this file to .env (or provide as container environment variables).
# 2. NEVER commit the actual .env file or real secrets to version control.
# 3. Generate high-entropy secrets using: openssl rand -hex 32
# ==============================================================================

# Core Flask Environment
FLASK_ENV=production
FLASK_DEBUG=False
PORT=5001

# Production Security Secrets (MUST be at least 32 characters, unique and random)
# Generate with: openssl rand -hex 32
SECRET_KEY=replace-with-openssl-rand-hex-32-production-secret-key-min-32-chars
JWT_SECRET_KEY=replace-with-openssl-rand-hex-32-jwt-production-secret-min-32-chars
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=120

# Authentication & Brute-Force Defense
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_SECONDS=900

# MongoDB Atlas Secure Connectivity
# Format: mongodb+srv://<username>:<password>@<cluster-domain>/<dbname>?retryWrites=true&w=majority&appName=ForenVisionAI
# Security Rules:
# - Use dedicated least-privilege database user (readWrite on forenvision_db only)
# - Restrict IP access list to your application server IP(s) or VPC peering
# - Enforce TLS 1.2+ (enabled by default on Atlas)
MONGODB_URI=mongodb+srv://forenvision_app_user:REPLACE_WITH_STRONG_PASSWORD@your-cluster.mongodb.net/forenvision_db?retryWrites=true&w=majority&appName=ForenVisionAI
MONGODB_DB_NAME=forenvision_db

# PyMongo Connection Pooling & Resilience
DB_CONNECT_TIMEOUT_MS=5000
DB_SERVER_SELECTION_TIMEOUT_MS=5000
DB_SOCKET_TIMEOUT_MS=10000
DB_MAX_POOL_SIZE=50
DB_MIN_POOL_SIZE=5

# Strict CORS Configuration
# MUST specify explicit approved origin(s) matching your deployed frontend.
# NEVER use '*' in production. Multiple origins can be comma-separated:
FRONTEND_ORIGIN=https://forenvision.example.com,https://app.forenvision.example.com

# Private Forensic Evidence Vault Storage
# Store OUTSIDE the web server root. Directory permissions: 0700, Files: 0640.
UPLOAD_FOLDER=/var/forenvision/evidence_vault
MAX_CONTENT_LENGTH=20971520  # 20 MB max payload limit

# Structured Application Logging
LOG_DIR=/var/log/forenvision
LOG_LEVEL=INFO

# AI Compute Limits & Resource Ceilings
# Limits internal OpenCV thread pool to prevent thread starvation under multi-worker WSGI
OPENCV_NUM_THREADS=2
MAX_IMAGE_PIXELS=100000000  # 100 Megapixel safety limit against decompression bombs

# Gunicorn WSGI Concurrency Settings (used by gunicorn.conf.py)
GUNICORN_BIND=0.0.0.0:5001
GUNICORN_WORKERS=4
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=120
GUNICORN_MAX_REQUESTS=1000
GUNICORN_MAX_REQUESTS_JITTER=50
