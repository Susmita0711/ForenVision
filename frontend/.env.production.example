# ForenVision AI Production Frontend Environment Template
# Copy this file to .env.production when customizing your frontend build

# Option 1: Standard Same-Domain / Reverse Proxy Deployment (RECOMMENDED)
# When frontend is served behind Nginx with proxy_pass /api/ to backend:
VITE_API_BASE_URL=/api

# Option 2: Decoupled CDN / Cross-Origin Deployment
# When frontend is hosted on AWS S3/CloudFront/Vercel and backend is on separate domain:
# VITE_API_BASE_URL=https://api.forenvision.example.com/api
