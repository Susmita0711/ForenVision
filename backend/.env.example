# ForenVision AI Backend Configuration Template
# Copy this file to .env and configure your variables

FLASK_ENV=development
FLASK_DEBUG=True
PORT=5001
SECRET_KEY=forenvision-dev-secret-key-change-in-production
JWT_SECRET_KEY=forenvision-jwt-secret-key-change-in-production
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=1440

# Login Rate Limiting (Brute-force protection)
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_SECONDS=300

# MongoDB Atlas Connection
# Format: mongodb+srv://<username>:<password>@<cluster-url>/<dbname>?retryWrites=true&w=majority
MONGODB_URI=
MONGODB_DB_NAME=forenvision_db

# Frontend CORS Origin (e.g. http://localhost:5173 for Vite dev server)
FRONTEND_ORIGIN=http://localhost:5173

# Database Connection Timeout (in milliseconds)
DB_CONNECT_TIMEOUT_MS=3000
DB_SERVER_SELECTION_TIMEOUT_MS=3000

# File Upload Configuration
MAX_CONTENT_LENGTH=16777216  # 16 MB max upload limit
UPLOAD_FOLDER=uploads
